FROM python:3.9-slim

# Prevent .pyc files and ensure logs are shown
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Set workdir
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry via pip to avoid installer failures
RUN python -m pip install --no-cache-dir "poetry==1.8.3"

# Copy project files
COPY pyproject.toml poetry.lock* ./
COPY verzekeringen_api/ verzekeringen_api/

# Install dependencies
RUN poetry install --no-interaction --no-ansi --only main

# Set Poetry virtualenv as default
ENV PYTHONPATH="/app"

# Run the app
CMD poetry run sh -c "\
    python verzekeringen_api/manage.py migrate && \
    python verzekeringen_api/manage.py collectstatic --noinput && \
    python verzekeringen_api/manage.py addinsurancetypes && \
    python verzekeringen_api/manage.py addinfovariables && \
    python verzekeringen_api/manage.py importinitialcountries && \
    python verzekeringen_api/manage.py runserver 0.0.0.0:8000"
